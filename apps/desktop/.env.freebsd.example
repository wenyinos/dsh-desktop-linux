# Copy to .env.freebsd (Git ignored). Use UTF-8 and quote secrets containing # or spaces.
# FreeBSD Desktop packages are assembled as pkg(8) packages through ordinary package channels
# rather than the managed update feed, so no signing identity, notarization credential,
# policy origin, or update destination is required.
DSH_DESKTOP_APP_ID=com.deepseek.harness

# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
# A local mirror such as https://registry.npmmirror.com speeds up repeated local packages.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com

# The installed FreeBSD Electron distribution the application is assembled with: the
# `electron<major>` package's data directory and the exact version it carries. The packaging
# workflow installs that package before assembling.
DSH_DESKTOP_FREEBSD_ELECTRON_ROOT=/usr/local/share/electron44
DSH_DESKTOP_FREEBSD_ELECTRON_VERSION=44.3.0

# Optional pkg metadata overrides for the package ident.
# DSH_DESKTOP_FREEBSD_MAINTAINER=DeepSeek <support@deepseek.com>
# DSH_DESKTOP_FREEBSD_PACKAGE_NAME=deepseek-harness
# DSH_DESKTOP_FREEBSD_VENDOR=DeepSeek
