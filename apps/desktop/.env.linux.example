# Copy to .env.linux (Git ignored). Use UTF-8 and quote secrets containing # or spaces.
# Linux Desktop packages are distributed as deb and rpm through ordinary package channels
# rather than the managed update feed, so no signing identity, notarization credential,
# policy origin, or update destination is required.
DSH_DESKTOP_APP_ID=com.deepseek.harness

# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
# A local mirror such as https://registry.npmmirror.com speeds up repeated local packages.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com

# Optional fpm metadata overrides for the deb and rpm package ident.
# DSH_DESKTOP_LINUX_MAINTAINER=DeepSeek
# DSH_DESKTOP_LINUX_PACKAGE_NAME=deepseek-harness
# DSH_DESKTOP_LINUX_VENDOR=DeepSeek
