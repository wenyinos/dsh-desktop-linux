#!/bin/sh
# Run the installed CLI without changing the invoking shell or working directory.
# Linux keeps the application executable beside the resources directory, unlike the
# macOS bundle, so this launcher resolves its sibling instead of Contents/MacOS.
set -e
launcher=$0
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$directory/$target ;;
  esac
done
resources=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
application="$resources/../deepseek-harness"
cli="$resources/app.asar/dsh/node_modules/@deepseek-ai/dsh-desktop-host/lib/cli.js"
# The CLI runs its bundled package manager as its own executable, and the FreeBSD Electron build
# crashes when it spawns itself as Node. The Node stub starts the CLI there instead, and the hook
# it loads reroutes those spawns; other platforms run the application directly.
stub="$resources/runtime/bin/node"
if [ "$(uname -s)" = "FreeBSD" ] && [ -x "$stub" ]; then
  DSH_DESKTOP_NODE_EXECUTABLE="$application" exec "$stub" "$cli" "$@"
fi
ELECTRON_RUN_AS_NODE=1 exec "$application" --expose-internals "$cli" "$@"
